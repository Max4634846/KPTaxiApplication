<Window x:Class="KPTaxiApplication.Views.AddEditPageOrders"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KPTaxiApplication.Views" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="AddEditPageOrders" Height="450" Width="800"    Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True">

    <Border Background="#eff2f7" BorderBrush="#816aba" BorderThickness="3" CornerRadius="30" MouseDown="Border_MouseDown" Opacity="0.95"  x:Name="Border">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />





            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="8" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30 0" x:Name="NumOrders">
                <TextBlock Text="Номер заказа:  " FontWeight="Bold" />
                <TextBlock x:Name="idOrder" FontWeight="Bold" />

            </WrapPanel>

            <TextBlock Text="Номер автомобиля" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ComboBox x:Name="NumAvto"  Grid.Row="0" Grid.Column="1"  Width="150" Height="35" />


            <TextBlock Grid.Row="1"  Text="Номер клиента" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ComboBox x:Name="NumClient" Grid.Row="1" Grid.Column="1"  Width="150" Height="35"/>

            <TextBlock Grid.Row="2" Text="Номер тарифа" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ComboBox x:Name="NumTariff" Grid.Row="2" Grid.Column="1"  Width="150" Height="35"/>

            <TextBlock Grid.Row="3"  Text="Откуда" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="Otkuda" Grid.Row="3" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <TextBlock Grid.Row="4" Text="Куда" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="Kuda" Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <TextBlock Grid.Row="5"  Text="Время начала заказа" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <xctk:MaskedTextBox Mask="00:00:00" x:Name="TimeStartSakasa" Grid.Row="5" Grid.Column="1" Style="{StaticResource TextBoxStyle}" BorderThickness="0 0 0 0" BorderBrush="Transparent" Width="150"/>

            <TextBlock Grid.Row="6" Text="Время окончания заказа" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <xctk:MaskedTextBox Mask="00:00:00" x:Name="TimeFinishSakasa" Grid.Row="6" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150" BorderThickness="0 0 0 0" BorderBrush="Transparent"/>

            <TextBlock Grid.Row="7" Text="Время заказа" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="TimeSakasa" Grid.Row="7" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Дата" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <DatePicker x:Name="Data" Grid.Row="0" Grid.Column="3" Width="150" Height="25"/>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Путь в км" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <xctk:MaskedTextBox x:Name="PutiKm" Grid.Row="1" Grid.Column="3" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <TextBlock Grid.Row="2" Grid.Column="2" Text="Статус заказа" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ComboBox x:Name="StatusSakasa" Grid.Row="2" Grid.Column="3"  Width="150" Height="35">
                <ComboBoxItem Content="Активный" />
                <ComboBoxItem Content="Завершен" />
            </ComboBox>


            <TextBlock Grid.Row="3" Grid.Column="2" Text="Багаж" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ComboBox x:Name="Bagaje" Grid.Row="3" Grid.Column="3" Height="35" Width="150">
                <ComboBoxItem Content="True" />
                <ComboBoxItem Content="False" />
            </ComboBox>

            <TextBlock Grid.Row="4" Grid.Column="2" Text="Выбор оплаты" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ComboBox x:Name="VuborOplati" Grid.Row="4" Grid.Column="3" Height="35" Width="150">
                <ComboBoxItem Content="Карта" />
                <ComboBoxItem Content="Наличные" />
            </ComboBox>

            <TextBlock Grid.Row="5" Grid.Column="2" Text="Ожидание" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ComboBox x:Name="Ojidanie" Grid.Row="5" Grid.Column="3" Height="35" Width="150">
                <ComboBoxItem Content="True" />
                <ComboBoxItem Content="False" />
            </ComboBox>

            <TextBlock Grid.Row="6" Grid.Column="2" Text="Оценка" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ComboBox x:Name="Ocenka" Grid.Row="6" Grid.Column="3" Height="35" Width="150">
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
                <ComboBoxItem Content="4" />
                <ComboBoxItem Content="5" />

            </ComboBox>


            <Button x:Name="Back" Grid.Row="16" Grid.Column="1" Content="Назад" FontSize="10" Width="100" Height="20" Style="{StaticResource addButton}" HorizontalAlignment="Center" VerticalAlignment="Top" Click="Close_Click" Margin="0,20,0,0"/>
            <Button x:Name="Edit" Grid.Row="16" Grid.Column="0" Content="Изменить" FontSize="10" Width="100" Height="20" Style="{StaticResource addButton}" HorizontalAlignment="Center" VerticalAlignment="Top"  Click="Edit_Click" Margin="0,20,0,0" />
            <Button x:Name="Add"  Grid.Row="16" Grid.Column="0" Content="Добавить" FontSize="10" Width="100" Height="20" Style="{StaticResource addButton}" HorizontalAlignment="Center" VerticalAlignment="Top"  Click="Add_Click" Margin="0,20,0,0" />
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Border>
</Window>
