<Window x:Class="KPTaxiApplication.Views.CardPageSotrudnik"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KPTaxiApplication.Views"
        mc:Ignorable="d"
        Title="CardPageSotrudnik" Height="450" Width="850"
        WindowStyle="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True">

    <Border Margin="30 0 20 30" BorderBrush="#878787" BorderThickness=" 0 3 0  3" Background="White" CornerRadius="30 0 30 0" MouseDown="Border_MouseDown">
        <Grid Margin="30 20 20 30">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#969696" CornerRadius="30" Width="730" Height="344">
                <StackPanel Margin="20">
                    <TextBlock Text="Карточка сотрудника" Style="{StaticResource GlowingTextBlock}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="28" Foreground="White">

                    </TextBlock>
                    <TextBlock x:Name="txtStatus" FontSize="18" Foreground="AliceBlue" FontWeight="Bold"/>
                    <TextBlock x:Name="txtNameUser" FontSize="18" Foreground="AliceBlue" FontWeight="Bold"/>
                    <TextBlock x:Name="txtNumberPhone" FontSize="18" Foreground="AliceBlue" FontWeight="Bold"/>
                    <TextBlock x:Name="txtMail" FontSize="18" Foreground="AliceBlue" FontWeight="Bold"/>
                    <TextBlock x:Name="txtPasport" FontSize="18" Foreground="AliceBlue" FontWeight="Bold"/>
                    <TextBlock x:Name="txtOpicanie" FontSize="18" Foreground="AliceBlue"  FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</Window>
