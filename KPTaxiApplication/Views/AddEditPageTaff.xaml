<Window x:Class="KPTaxiApplication.Views.AddEditPageTaff"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KPTaxiApplication.Views"
        mc:Ignorable="d"
        Title="AddEditPageTaff" Height="250" Width="350"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True">

    <Border x:Name="Border" Background="#eff2f7" BorderBrush="#816aba" BorderThickness="3" CornerRadius="30" MouseDown="Border_MouseDown" Opacity="0.95">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>


            <TextBlock Text="Название тарифа" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="NameTaff" Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <TextBlock Grid.Row="1"  Text="Описание" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="Opicanie" Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <TextBlock Grid.Row="2" Text="Стоимость за км" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="CtoimictiKm" Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <WrapPanel Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10 0">
                <TextBlock x:Name="idTaffText" Text="Номер тарифа: " FontWeight="Bold" />
                <TextBlock x:Name="idTaff" FontWeight="Bold" />
            </WrapPanel>

            <Button x:Name="Back" Grid.Row="12" Grid.Column="1" Content="Назад" FontSize="10" Width="100" Height="20" Style="{StaticResource addButton}" HorizontalAlignment="Center" VerticalAlignment="Top" Click="Close_Click" Margin="0,15,0,0"/>
            <Button x:Name="Edit"  Grid.Row="12" Grid.Column="0" Content="Изменить" FontSize="10" Width="100" Height="20" Style="{StaticResource addButton}" HorizontalAlignment="Center" VerticalAlignment="Top"  Click="Edit_Click"  Margin="0,15,0,0" />
            <Button x:Name="Add" Grid.Row="12" Grid.Column="0" Content="Добавить" FontSize="10" Width="100" Height="20" Style="{StaticResource addButton}" HorizontalAlignment="Center" VerticalAlignment="Top"  Click="Add_Click"  Margin="0,15,0,0" />
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Border>
</Window>
