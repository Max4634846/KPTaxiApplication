<Page x:Class="KPTaxiApplication.Views.PersonalAccount"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KPTaxiApplication.Views"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1980"
      Title="PersonalAccount">

    <Grid>
        <Border Margin="30 80 20 30" BorderBrush="#878787" BorderThickness=" 0 3 0  3" Background="White" CornerRadius="30 0 30 0">
            <Grid Margin="30 20 20 30">
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,30,0,0" Background="#969696" CornerRadius="30" Width="790" Height="272">
                    <StackPanel Margin="20">
                        <TextBlock Text="Аккаунт" Style="{StaticResource GlowingTextBlock}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="28" Foreground="White">

                        </TextBlock>
                        <TextBlock x:Name="txtStatus" FontSize="18" Foreground="AliceBlue" FontWeight="Bold"/>
                        <TextBlock x:Name="txtNameUser" FontSize="18" Foreground="AliceBlue" FontWeight="Bold"/>
                        <TextBlock x:Name="txtNumberPhone" FontSize="18" Foreground="AliceBlue" FontWeight="Bold"/>
                        <TextBlock x:Name="txtMail" FontSize="18" Foreground="AliceBlue" FontWeight="Bold"/>
                        <TextBlock x:Name="txtPasport" FontSize="18" Foreground="AliceBlue" FontWeight="Bold"/>
                        <TextBlock x:Name="txtOpicanie" FontSize="18" Foreground="AliceBlue"  FontWeight="Bold"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Page>
