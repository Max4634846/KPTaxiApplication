<Page x:Class="KPTaxiApplication.Views.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KPTaxiApplication.Views" xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1980"
      Title="OrdersPage"
      >

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>



    <Grid Margin="30 20 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="450" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>
        <Grid Width="300" HorizontalAlignment="Left" Visibility="Hidden">
            <TextBlock Margin="20 0" VerticalAlignment="Center" Foreground="#b0b9c6" IsHitTestVisible="False"
                Panel.ZIndex="1" Text="Seacr here..." Visibility="{Binding ElementName=txtSearch, Path=Text.Empty, Converter={StaticResource BoolToVis}}"/>
            <TextBox x:Name="txtSearch" Style="{StaticResource textboxSearch}"/>
            <Icon:PackIconMaterial Kind="Magnify" Width="15" Height="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 15 0" Foreground="#b0b9c6"/>
        </Grid>



        <Button Style="{StaticResource topButton}" Margin="0 0 20 0" Background="#dcdcdcdc" HorizontalAlignment="Right">
            <Icon:PackIconMaterial Kind="Cog" />
        </Button>

        <Button Style="{StaticResource topButton}" Margin="0 0 55 0" HorizontalAlignment="Right">
            <Icon:PackIconMaterial Kind="Bell" />
        </Button>

        <Button Style="{StaticResource addButtonDis}" Click="WebDate_Click" Width="250" x:Name="web">
            <StackPanel Orientation="Horizontal">
                <Icon:PackIconMaterial  Kind="Plus" VerticalAlignment="Center" Width="11" Height="11" Margin="0 1 8 0"/>
                <TextBlock Text="Добавить данные с карты" />
            </StackPanel>
        </Button>

        <TextBlock Text="Заказы" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0"
            HorizontalAlignment="Left" Foreground="#121518"/>

        <TextBlock Text="Filter by" Grid.Row="4" FontSize="13" FontWeight="SemiBold" Margin="0 0 215 0" Foreground="#121518" 
            HorizontalAlignment="Right" VerticalAlignment="Center"/>

        <Grid Grid.Row="4">
            <DockPanel>
                <wv2:WebView2 x:Name="webView" Source="https://maps.google.com" />
            </DockPanel>
        </Grid>
        <Grid Width="200" HorizontalAlignment="Right" Grid.Row="5">
            <TextBlock x:Name="searchPlaceholder" Margin="20 0" VerticalAlignment="Center" Foreground="#b0b9c6" 
           IsHitTestVisible="False" Panel.ZIndex="1" Text="Search in Users...">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text.Length, ElementName=txtFilter}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBox x:Name="txtFilter" Style="{StaticResource textboxFilter}" TextChanged="TextBox_Change"/>

        </Grid>




        <DataGrid Grid.Row="6"  x:Name="DGOrder" MouseDoubleClick="DGOrder_MouseDoubleClick" HeadersVisibility="Column" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" AutoGenerateColumns="False"   IsReadOnly="True"  Style="{StaticResource dataGridDis}">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="one" Header="Номер клиента" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding id_Client}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="two" Header="Номер автомобиля" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding id_Avto}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="three" Header="Номер тарифа" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding id_Taff}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="fout" Header="Место посадки" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding Otkuda}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="five" Header="Место отправления" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding Kuda}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="six" Header="Время начала заказа" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding StartTime}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="seven" Header="Время окончания заказа" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding FinishTimne}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="eqiht" Header="Время заказа" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding EndTime}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="nine" Header="Дата" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding Date}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="ten" Header="Путь в км" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding PutKm}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="eleven" Header="Статус заказа" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding StatusOrder}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="twelve" Header="Стоимость" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding Price}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="thriteen" Header="Багаж" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding Bagaje}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="fourteen" Header="Выбор оплаты" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding ViborOplate}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="fifteen" Header="Ожидание" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding Expectation}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn x:Name="sixteen" Header="Оценка за обслуживание" HeaderStyle="{StaticResource dataGridHeaderDis}" Binding="{Binding Estimation}" Width="*"></DataGridTextColumn>
                <DataGridTemplateColumn x:Name="Header" Width="*" HeaderStyle="{StaticResource dataGridHeaderDis}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Name="BtnEdit" Background="#816aba" Click="Delete_Click">
                                <Icon:PackIconMaterial  Kind="Delete" VerticalAlignment="Center" Width="11" Height="11" Margin="0 1 8 0"/>

                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />
    </Grid>
</Page>
