<Window x:Class="KPTaxiApplication.Views.AddEditPageClient"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KPTaxiApplication.Views" 
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d" 
      Height="350" Width="350"
      Title="AddEditPageClient"
      Background="Transparent"
      WindowStyle="None"
      WindowStartupLocation="CenterScreen"
      AllowsTransparency="True">

        <Border Background="#eff2f7" BorderBrush="#816aba" BorderThickness="3" CornerRadius="30" MouseDown="Border_MouseDown" Opacity="0.95" x:Name="Border">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />



                </Grid.RowDefinitions>

                <TextBlock x:Name="idText" Text="Номер клиента: " HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="id" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Text="Имя" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox x:Name="nameTextBox"  Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

                <TextBlock Grid.Row="2"  Text="Фамилия" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox  x:Name="surnameTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBoxStyle}"  Width="150"/>

                <TextBlock Grid.Row="3" Text="Отчество" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox  x:Name="patronymicTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

                <TextBlock Grid.Row="4"  Text="Номер телефона" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <xctk:MaskedTextBox Mask="+7(000)000-00-00" x:Name="numberTextBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150" />



                <Button x:Name="Back" Grid.Row="12" Grid.Column="1" Content="Назад" FontSize="10" Width="100" Height="20" Style="{StaticResource addButton}" HorizontalAlignment="Center" VerticalAlignment="Top" Click="Close_Click" Margin="0,15,0,0"/>
                <Button x:Name="AddClient"  Grid.Row="12" Grid.Column="0" Content="Изменить" FontSize="10" Width="100" Height="20" Style="{StaticResource addButton}" HorizontalAlignment="Center" VerticalAlignment="Top"  Click="AddBD_Click" Margin="0,15,0,0" />
                <Button x:Name="Edit"  Grid.Row="12" Grid.Column="0" Content="Добавить" FontSize="10" Width="100" Height="20" Style="{StaticResource addButton}" HorizontalAlignment="Center" VerticalAlignment="Top"  Click="Add_Click" Margin="0,15,0,0" />
                
            </Grid>
        </Border>
</Window>
