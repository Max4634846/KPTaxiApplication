<Window x:Class="KPTaxiApplication.Views.AddEditPageSot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KPTaxiApplication.Views" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d" 
      Title="AddEditPageSot"
      Height="550" Width="350"
      Background="Transparent"
      WindowStyle="None"
      WindowStartupLocation="CenterScreen"
      AllowsTransparency="True">

    <Border x:Name="Border" Background="#eff2f7" BorderBrush="#816aba" BorderThickness="3" CornerRadius="30" MouseDown="Border_MouseDown" Opacity="0.95">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>


            <TextBlock Text="Номер должности" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ComboBox x:Name="NumDol"  Grid.Row="0" Grid.Column="1" Height="25" Width="150"/>

            <TextBlock Grid.Row="1"  Text="Логин" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="Login"  Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <TextBlock Grid.Row="2" Text="Пароль" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="Password"  Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <TextBlock Grid.Row="3"  Text="Имя" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="Name"  Grid.Row="3" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>
            <TextBlock Grid.Row="4" Text="Фамилия" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="Fam"  Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <TextBlock Grid.Row="5" Text="Отчество" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="Pot" Grid.Row="5" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <TextBlock Grid.Row="6" Text="Статус" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ComboBox x:Name="Status" Grid.Row="6" Grid.Column="1" Height="25" Width="150">
                <ComboBoxItem Content="Работает" />
                <ComboBoxItem Content="Не работает" />
            </ComboBox>

            <TextBlock Grid.Row="7" Text="Рейтинг" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ComboBox x:Name="Reiting"  Grid.Row="7" Grid.Column="1" Height="25" Width="150">
                <ComboBoxItem Content="3,5" />
            </ComboBox>

            <TextBlock Grid.Row="8" Text="Номер телефона" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <xctk:MaskedTextBox Mask="+7(000)000-00-00" x:Name="NumTel" Grid.Row="8" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <TextBlock Grid.Row="9" Text="Почта" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="Mail"  Grid.Row="9" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <TextBlock Grid.Row="10" Height="30" Text="Паспортные данные" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <xctk:MaskedTextBox Mask="00 00 000000" x:Name="PaspDanie"  Grid.Row="10" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <TextBlock Grid.Row="11" Height="30" Text="Адрес" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="Adress"  Grid.Row="11" Grid.Column="1" Style="{StaticResource TextBoxStyle}" Width="150"/>

            <WrapPanel Grid.Row="12" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10 0">
                <TextBlock x:Name="idSotText" Text="Номер сотрудника: " HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock  x:Name="idSot" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </WrapPanel>

            <Button x:Name="Back" Grid.Row="13" Grid.Column="1" Content="Назад" FontSize="10" Width="100" Height="20" Style="{StaticResource addButton}" HorizontalAlignment="Center" VerticalAlignment="Top" Click="Close_Click" Margin="0,15,0,0"/>
            <Button x:Name="Edit" Grid.Row="13" Grid.Column="0" Content="Изменить" FontSize="10" Width="100" Height="20" Style="{StaticResource addButton}" HorizontalAlignment="Center" VerticalAlignment="Top" Click="Edit_Click"  Margin="0,15,0,0" />
            <Button x:Name="Add" Grid.Row="13" Grid.Column="0" Content="Добавить" FontSize="10" Width="100" Height="20" Style="{StaticResource addButton}" HorizontalAlignment="Center" VerticalAlignment="Top" Click="Add_Click"  Margin="0,15,0,0" />
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Border>
</Window>
