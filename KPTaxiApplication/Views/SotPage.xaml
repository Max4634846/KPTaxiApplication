<Page x:Class="KPTaxiApplication.Views.SotPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KPTaxiApplication.Views" xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SotPage">


    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    
    <Grid Margin="30 20 20 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Width="300" HorizontalAlignment="Left" Visibility="Hidden">
            <TextBlock Margin="20 0" VerticalAlignment="Center" Foreground="#b0b9c6" IsHitTestVisible="False"
            Panel.ZIndex="1" Text="Seacr here..." Visibility="{Binding ElementName=txtSearch, Path=Text.Empty, Converter={StaticResource BoolToVis}}"/>
            <TextBox x:Name="txtSearch" Style="{StaticResource textboxSearch}"/>
            <Icon:PackIconMaterial Kind="Magnify" Width="15" Height="15" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 15 0" Foreground="#b0b9c6"/>
        </Grid>

        <Button Style="{StaticResource topButton}" Margin="0 0 20 0" Background="#dcdcdcdc" HorizontalAlignment="Right" >
            <Icon:PackIconMaterial Kind="Download" />
        </Button>

        <Button Style="{StaticResource topButton}" Margin="0 0 55 0" HorizontalAlignment="Right">
            <Icon:PackIconMaterial Kind="Bell" />
        </Button>

        <Button Style="{StaticResource addButton}" Click="Add_Click">
            <StackPanel Orientation="Horizontal">
                <Icon:PackIconMaterial  Kind="Plus" VerticalAlignment="Center" Width="11" Height="11" Margin="0 1 8 0"/>
                <TextBlock Text="Добавить" />
            </StackPanel>
        </Button>

        <TextBlock Text="Сотрудники" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0"
        HorizontalAlignment="Left" Foreground="#121518"/>

        <TextBlock Text="Filter by" Grid.Row="4" FontSize="13" FontWeight="SemiBold" Margin="0 0 215 0" Foreground="#121518" 
        HorizontalAlignment="Right" VerticalAlignment="Center"/>

        <Grid Width="200" HorizontalAlignment="Right" Grid.Row="4">
            <TextBlock x:Name="searchPlaceholder" Margin="20 0" VerticalAlignment="Center" Foreground="#b0b9c6" 
           IsHitTestVisible="False" Panel.ZIndex="1" Text="Search in Users...">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text.Length, ElementName=txtFilter}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBox x:Name="txtFilter" Style="{StaticResource textboxFilter}" TextChanged="TextBox_Changed"/>
        </Grid>



        <Border Grid.Row="6" HorizontalAlignment="Right" BorderBrush="#dee4ec" BorderThickness="1"
     CornerRadius="5">
        </Border>
        <DataGrid Grid.Row="5"  x:Name="DGSotrudniki" MouseDoubleClick="DGSotrudniki_MouseDoubleClick" HeadersVisibility="Column" AutoGenerateColumns="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"  IsReadOnly="True"  Style="{StaticResource dataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер Должности" HeaderStyle="{StaticResource dataGridHeader}" Binding="{Binding id_Dol}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Логин" HeaderStyle="{StaticResource dataGridHeader}" Binding="{Binding Login}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Пароль" HeaderStyle="{StaticResource dataGridHeader}" Binding="{Binding Password}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Имя" HeaderStyle="{StaticResource dataGridHeader}" Binding="{Binding FirstName}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Фамилия" HeaderStyle="{StaticResource dataGridHeader}" Binding="{Binding SurName}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Отчество" HeaderStyle="{StaticResource dataGridHeader}" Binding="{Binding Patroniec}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Статус" HeaderStyle="{StaticResource dataGridHeader}" Binding="{Binding Status}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Рейтинг" HeaderStyle="{StaticResource dataGridHeader}" Binding="{Binding Rating}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Номер" HeaderStyle="{StaticResource dataGridHeader}" Binding="{Binding NumPhone}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Почта" HeaderStyle="{StaticResource dataGridHeader}" Binding="{Binding Email}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Паспорт" HeaderStyle="{StaticResource dataGridHeader}" Binding="{Binding Pasport}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Адрес" HeaderStyle="{StaticResource dataGridHeader}" Binding="{Binding Address}" Width="*"></DataGridTextColumn>
                <DataGridTemplateColumn x:Name="HeaderSix" Width="100" HeaderStyle="{StaticResource dataGridHeader}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Name="BtnEdit" Background="#816aba" Click="Delete_Click">
                                <Icon:PackIconMaterial  Kind="Delete" VerticalAlignment="Center" Width="11" Height="11" Margin="0 1 8 0"/>

                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />
    </Grid>
</Page>
